add_executable(tgt_exe_{{ exename }})

set_property(TARGET tgt_exe_{{ exename }} PROPERTY OUTPUT_NAME {{ exename }})

target_compile_definitions(
    tgt_exe_{{ exename }}
    PRIVATE
        $<$<CONFIG:Debug>:DEBUG>
)

target_compile_features(
    tgt_exe_{{ exename }}
    PRIVATE
        {{ c_std }}
)

target_compile_options(
    tgt_exe_{{ exename }}
    PRIVATE
        -Wall
        -Wextra
        -pedantic
        -fPIE
        $<$<CONFIG:Debug>:-g>
        $<$<CONFIG:Debug>:-O0>
        $<$<CONFIG:Debug>:-fsanitize=address>
        $<$<CONFIG:Release>:-Werror>
)

target_include_directories(
    tgt_exe_{{ exename }}
    PRIVATE
        ../{{ external_directory }}/their/include
)

target_link_libraries(
    tgt_exe_{{ exename }}
    PRIVATE
        tgt_lib_their
)

target_link_options(
    tgt_exe_{{ exename }}
    PRIVATE
        -pie
        $<$<CONFIG:Debug>:-fsanitize=address>
)

target_sources(
    tgt_exe_{{ exename }}
    PRIVATE
        addition.c
        division.c
        main.c
        multiplication.c
        subtraction.c
)

install(TARGETS tgt_exe_{{ exename }})
